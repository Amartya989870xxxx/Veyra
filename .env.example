# Veyra environment configuration. Copy to `.env` and fill in locally.
# NEVER commit a populated .env. No real card data, OTPs, or production credentials.

VEYRA_ENVIRONMENT=local
VEYRA_LOG_LEVEL=INFO
VEYRA_LOG_FORMAT=json

# --- storage -----------------------------------------------------------------------
# PostgreSQL is the intended system of record:
# VEYRA_DATABASE_URL=postgresql+asyncpg://veyra:veyra@localhost:5432/veyra
# SQLite fallback keeps the prototype runnable with no infrastructure:
VEYRA_DATABASE_URL=sqlite+aiosqlite:///./veyra.db
VEYRA_DB_ECHO=false

VEYRA_REDIS_URL=redis://localhost:6379/0
VEYRA_REDIS_ENABLED=true

# --- api ---------------------------------------------------------------------------
# Leave VEYRA_API_KEY unset for local development; set both to enable bearer auth.
VEYRA_REQUIRE_AUTH=false
# VEYRA_API_KEY=
VEYRA_RATE_LIMIT_PER_MINUTE=600
VEYRA_MAX_REQUEST_BYTES=1048576

# --- semantic (LLM) layer ----------------------------------------------------------
# Entirely optional. With this off, Veyra runs deterministic + ML only and says so.
VEYRA_SEMANTIC_ENABLED=false
VEYRA_SEMANTIC_PROVIDER=null
VEYRA_SEMANTIC_MODEL=claude-sonnet-5
# VEYRA_SEMANTIC_API_KEY=
VEYRA_SEMANTIC_TIMEOUT_SECONDS=8.0

# --- expected-loss assumptions (synthetic; see docs/evaluation.md) -----------------
VEYRA_FN_COST_MULTIPLIER=1.0
VEYRA_FP_COST_MULTIPLIER=0.25
VEYRA_REVIEW_COST_FLAT=40.0
VEYRA_CHARGEBACK_FEE_FLAT=750.0
