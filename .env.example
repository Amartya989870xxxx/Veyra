# Tyche environment configuration. Copy to `.env` and fill in locally.
# NEVER commit a populated .env. No real card data, OTPs, or production credentials.

TYCHE_ENVIRONMENT=local
TYCHE_LOG_LEVEL=INFO
TYCHE_LOG_FORMAT=json

# --- storage -----------------------------------------------------------------------
# PostgreSQL is the intended system of record:
# TYCHE_DATABASE_URL=postgresql+asyncpg://tyche:tyche@localhost:5432/tyche
# SQLite fallback keeps the prototype runnable with no infrastructure:
TYCHE_DATABASE_URL=sqlite+aiosqlite:///./tyche.db
TYCHE_DB_ECHO=false

TYCHE_REDIS_URL=redis://localhost:6379/0
TYCHE_REDIS_ENABLED=true

# --- api ---------------------------------------------------------------------------
# Leave TYCHE_API_KEY unset for local development; set both to enable bearer auth.
TYCHE_REQUIRE_AUTH=false
# TYCHE_API_KEY=
TYCHE_RATE_LIMIT_PER_MINUTE=600
TYCHE_MAX_REQUEST_BYTES=1048576

# --- semantic (LLM) layer ----------------------------------------------------------
# Entirely optional. With this off, Tyche runs deterministic + ML only and says so.
TYCHE_SEMANTIC_ENABLED=false
TYCHE_SEMANTIC_PROVIDER=null
TYCHE_SEMANTIC_MODEL=claude-sonnet-5
# TYCHE_SEMANTIC_API_KEY=
TYCHE_SEMANTIC_TIMEOUT_SECONDS=8.0

# --- expected-loss assumptions (synthetic; see docs/evaluation.md) -----------------
TYCHE_FN_COST_MULTIPLIER=1.0
TYCHE_FP_COST_MULTIPLIER=0.25
TYCHE_REVIEW_COST_FLAT=40.0
TYCHE_CHARGEBACK_FEE_FLAT=750.0
