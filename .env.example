# Veyra environment configuration. Copy to `.env` and fill in locally.
# NEVER commit a populated .env. No real card data, OTPs, or production credentials.

VEYRA_ENVIRONMENT=local
VEYRA_LOG_LEVEL=INFO
VEYRA_LOG_FORMAT=json

# --- storage -----------------------------------------------------------------------
# PostgreSQL is the intended system of record:
# VEYRA_DATABASE_URL=postgresql+asyncpg://veyra:veyra@localhost:5432/veyra
# SQLite fallback keeps the prototype runnable with no infrastructure:
VEYRA_DATABASE_URL=sqlite+aiosqlite:///./veyra.db
VEYRA_DB_ECHO=false

VEYRA_REDIS_URL=redis://localhost:6379/0
VEYRA_REDIS_ENABLED=true

# --- api ---------------------------------------------------------------------------
# Local/test/ci/demo: leave VEYRA_API_KEYS unset and requests fall back to a single,
# explicit, non-production demo principal (app/core/auth.py). Set VEYRA_REQUIRE_AUTH=true
# to force real credential checking in a non-production environment too (e.g. staging).
#
# environment=production ALWAYS requires real credentials, VEYRA_REQUIRE_AUTH is not
# read in that case — and Settings refuses to even start in production without
# VEYRA_API_KEYS, VEYRA_CRYPTO_PEPPER, and VEYRA_CORS_ALLOWED_ORIGINS all set.
VEYRA_REQUIRE_AUTH=false
# JSON array of configured principals. role is one of: viewer, analyst, merchant_admin,
# system_service (system_service is not tied to one merchant_id).
# VEYRA_API_KEYS=[{"key":"vy_...","merchant_id":"m_electronics_01","role":"analyst"}]
VEYRA_RATE_LIMIT_PER_MINUTE=600
VEYRA_MAX_REQUEST_BYTES=1048576

# --- cors --------------------------------------------------------------------------
# Comma-separated exact origins allowed to make credentialed requests. Never a wildcard
# — a literal "*" is dropped rather than trusted. Required in production.
# VEYRA_CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

# --- crypto --------------------------------------------------------------------------
# Master pepper for AES-GCM key derivation and HMAC instrument tokenization
# (app/core/crypto.py). Required in production; outside production an explicit,
# non-secret dev-only constant is used instead so a laptop run needs no configuration.
# VEYRA_CRYPTO_PEPPER=

# --- semantic (LLM) layer ----------------------------------------------------------
# Entirely optional. With this off, Veyra runs deterministic + ML only and says so.
VEYRA_SEMANTIC_ENABLED=false
VEYRA_SEMANTIC_PROVIDER=null
VEYRA_SEMANTIC_MODEL=claude-sonnet-5
# VEYRA_SEMANTIC_API_KEY=
VEYRA_SEMANTIC_TIMEOUT_SECONDS=8.0

# --- expected-loss assumptions (synthetic; see docs/evaluation.md) -----------------
VEYRA_FN_COST_MULTIPLIER=1.0
VEYRA_FP_COST_MULTIPLIER=0.25
VEYRA_REVIEW_COST_FLAT=40.0
VEYRA_CHARGEBACK_FEE_FLAT=750.0
