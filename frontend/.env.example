# Veyra frontend configuration.
#
# Everything here ships to the browser in plain text. Public configuration only
# — never put an API key, secret or credential in a VITE_ variable.

# Base URL of the Veyra API.
#   development : http://localhost:8008 (the default if unset)
#   deployment  : the https origin serving the FastAPI app
VITE_API_BASE_URL=http://localhost:8008

# Optional. Overrides the YouTube id for the product walkthrough on the Overview
# page. The permanent walkthrough (https://youtu.be/ldEY9BxSoCs) is hardcoded as
# the default in frontend/src/pages/OverviewPage.tsx, so this does NOT need to be
# set for the walkthrough to work in any environment, including Vercel. Set it
# only to preview a different video without a code change.
VITE_WALKTHROUGH_VIDEO_ID=
